// Merged by Nitro into .output/server/wrangler.json at build (nitro.cloudflare.deployConfig),
// which supplies main, assets and compatibility_date. Run wrangler after `bun run build`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ok8-sh",
  "routes": [{ "pattern": "ok8.sh", "custom_domain": true }],
  // Routes switch the workers.dev URL off, and preview URLs default to match it,
  // which would leave pull request Previews (deploy.yaml) without a URL.
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    // Nuxt links have no trailing slash; the default redirects /posts/x to /posts/x/.
    "html_handling": "drop-trailing-slash",
    // The curl card (server/plugins/curl-card.ts) has to see requests for `/`.
    "run_worker_first": ["/"]
  },
  // No IDs: wrangler creates these on the first deploy and keeps them linked.
  "d1_databases": [{ "binding": "DB" }],
  "kv_namespaces": [
    { "binding": "CACHE" },
    // Site-wide messages served by /api/meta (server/api/meta.get.ts).
    { "binding": "MESSAGES" }
  ],
  // Reached through ctx.exports, so each Preview gets its own namespace automatically.
  "exports": {
    "VisitorCounter": { "type": "durable-object", "storage": "sqlite" }
  },
  // Pull request Previews (deploy.yaml) share these, so they never touch production data.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "ok8-sh-preview", "database_id": "06429210-49f2-40c8-9b6b-92df45963fc4" }
    ],
    "kv_namespaces": [
      { "binding": "CACHE", "id": "f8cd22fa58ab499389be95e3789709d2" },
      { "binding": "MESSAGES", "id": "a806ca07b17643e5bb869ab77d5f6001" }
    ]
  }
}
